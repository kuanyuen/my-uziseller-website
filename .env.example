# Billplz Payment Gateway
BILLPLZ_API_KEY=your_billplz_api_key_here
BILLPLZ_COLLECTION_ID=your_collection_id_here
BILLPLZ_X_SIGNATURE_KEY=your_x_signature_key_here

# SHOP.APPMMO Supplier API (Subscriptions/Digital Products)
SHOP_APMMO_API_KEY=your_shop_apmmo_api_key_here
SHOP_APMMO_BASE=https://shop.appmmo.com/api

# SMM Panel Supplier API
SMM_API_KEY=your_smm_api_key_here
SMM_API_URL=https://smm.appmmo.com/api/v2

# Currency Exchange Rates (for pricing display)
# VND to MYR rate
VND_TO_MYR_RATE=0.000156
SHOP_VND_TO_MYR_RATE=0.000156
SMM_VND_TO_MYR_RATE=0.000156

# USD to MYR rate
USD_TO_MYR_RATE=4.04
SHOP_USD_TO_MYR_RATE=4.04
SMM_USD_TO_MYR_RATE=4.04

# CNY to MYR rate
CNY_TO_MYR_RATE=0.60
SHOP_CNY_TO_MYR_RATE=0.60
SMM_CNY_TO_MYR_RATE=0.60

# Markup Percentages (customer-facing price increase)
SMM_MARKUP_PERCENT=30
SUBSCRIPTION_MARKUP_PERCENT=30

# Admin Dashboard Password
ADMIN_PASSWORD=your_secure_admin_password_here

# Site Configuration
SITE_URL=https://your-domain.vercel.app

# Vercel KV (Redis) - Auto-injected by Vercel
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
